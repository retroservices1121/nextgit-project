{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextgit-project",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "nextgit"
    }
  ],
  "vars": {},
  "services": [
    {
      "binding": "EXECUTOR",
      "service": "nextgit-executor"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "NEXTGIT_STATE_KV"
    }
  ]
}
