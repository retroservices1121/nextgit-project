{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextgit-project",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "nextgit"
    }
  ],
  "vars": {},
  "services": [
    {
      "binding": "EXECUTOR",
      "service": "nextgit-executor"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "7a5548912018497fb61082af5000f22d"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
