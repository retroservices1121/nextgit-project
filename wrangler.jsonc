{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextgit-project",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "nextgit"
    }
  ],
  "vars": {},
  "services": [
    {
      "binding": "EXECUTOR",
      "service": "nextgit-executor"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "7a5548912018497fb61082af5000f22d"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nextgit-app",
      "database_id": "c54b4f4a-090b-481b-801e-3f20e16092aa"
    }
  ],
  "triggers": {
    "crons": [
      "*/1 * * * *"
    ]
  }
}
