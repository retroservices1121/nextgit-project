{
  "name": "nextgit-project",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-native software development platform prototype",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit --project tsconfig.control.json",
    "deploy:executor": "npm run build:executor && wrangler deploy --config wrangler.executor.jsonc",
    "build:executor": "tsc --noEmit --project tsconfig.executor.json"
  },
  "dependencies": {
    "@mastra/core": "latest",
    "@mastra/memory": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest",
    "@cloudflare/sandbox": "0.12.0"
  }
}
